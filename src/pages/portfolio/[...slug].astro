---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getProjects, seriesOf, url, type Post, type Project } from '../../lib/content';

export async function getStaticPaths() {
	const [projects, posts] = await Promise.all([getProjects(), getPosts()]);
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project, related: posts.filter((post) => post.data.project?.id === project.id) },
	}));
}

interface Props {
	project: Project;
	related: Post[];
}

const { project, related } = Astro.props;
const { title, description, period, status, role, tools, cover, links, draft } = project.data;
const { Content } = await render(project);
// Posts with `part` read as a series, first part first; the rest stay newest-first.
const series = seriesOf(related, project.id);
const others = related.filter((post) => post.data.part === undefined);
---

<BaseLayout title={title} description={description} image={cover}>
	<article class="container narrow">
		<header class="head">
			<a class="back" href={url('/portfolio/')}>← 프로젝트</a>
			<h1>
				{title}
				{draft && <span class="draft-badge">DRAFT · 배포되지 않음</span>}
			</h1>
			<p class="desc">{description}</p>

			<dl class="facts">
				<div>
					<dt>기간</dt>
					<dd>{period}{status === 'ongoing' && <span class="ongoing">진행 중</span>}</dd>
				</div>
				{
					role && (
						<div>
							<dt>역할</dt>
							<dd>{role}</dd>
						</div>
					)
				}
				{
					tools.length > 0 && (
						<div>
							<dt>도구</dt>
							<dd class="tools">
								{tools.map((tool) => (
									<span class="chip">{tool}</span>
								))}
							</dd>
						</div>
					)
				}
			</dl>

			{
				links.length > 0 && (
					<div class="links">
						{links.map(({ label, url: href }) => (
							<a class="button" href={href} target="_blank" rel="noopener">
								{label} ↗
							</a>
						))}
					</div>
				)
			}
		</header>

		{cover && <Image class="cover" src={cover} alt={`${title} 대표 이미지`} width={1440} />}

		<div class="prose">
			<Content />
		</div>

		{
			related.length > 0 && (
				<section class="related">
					<div class="section-title">
						<h2>이 프로젝트의 기록</h2>
					</div>
					{series.length > 0 && (
						<div class="series-guide">
							<p>
								전체 <strong>{series.length}편</strong> · 1편부터 순서대로 읽는 것을 권합니다.
							</p>
							<a class="button" href={url(`/posts/${series[0].id}/`)}>
								{series[0].data.part}편부터 읽기 →
							</a>
						</div>
					)}
					{series.length > 0 && <PostList posts={series} showPart />}
					{others.length > 0 && series.length > 0 && <h3 class="others-title">그 밖의 기록</h3>}
					{(others.length > 0 || series.length === 0) && <PostList posts={others} />}
				</section>
			)
		}
	</article>
</BaseLayout>

<style>
	.head {
		padding: 48px 0 32px;
	}
	.back {
		color: var(--muted);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
	}
	.back:hover {
		color: var(--primary);
	}
	h1 {
		margin: 14px 0 8px;
		font-size: clamp(1.7rem, 4.5vw, 2.3rem);
		line-height: 1.35;
		letter-spacing: -0.03em;
	}
	h1 .draft-badge {
		margin-left: 8px;
		font-size: 0.8rem;
	}
	.desc {
		margin: 0 0 24px;
		color: var(--muted);
		font-size: 1.05rem;
	}
	.facts {
		display: grid;
		gap: 10px;
		margin: 0;
		padding: 18px 20px;
		border: 1px solid var(--hairline);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: var(--edge);
		-webkit-backdrop-filter: var(--blur);
		backdrop-filter: var(--blur);
	}
	/* Label in 14px regular, value in bold — read the name, then the value. */
	.facts div {
		display: grid;
		grid-template-columns: 56px 1fr;
		gap: 12px;
		align-items: baseline;
	}
	dt {
		color: var(--muted);
		font-size: 0.875rem;
	}
	dd {
		margin: 0;
		font-size: 0.97rem;
		font-weight: 600;
	}
	.tools .chip {
		font-weight: 500;
	}
	.tools {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.ongoing {
		margin-left: 8px;
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 700;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 16px;
	}
	.links a {
		font-weight: 600;
	}
	.cover {
		display: block;
		width: 100%;
		margin-bottom: 40px;
		border: 1px solid var(--hairline);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}
	.related {
		margin-top: 64px;
	}
	.series-guide {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 10px 16px;
		margin-bottom: 14px;
	}
	.series-guide p {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.series-guide strong {
		color: var(--text);
		font-variant-numeric: tabular-nums;
	}
	.series-guide .button {
		font-weight: 600;
	}
	.others-title {
		margin: 32px 0 12px;
		color: var(--muted);
		font-size: 0.95rem;
	}
</style>
