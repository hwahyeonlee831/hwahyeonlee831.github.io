---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { CATEGORIES } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getProjects, readingMinutes, seriesOf, url, type Post } from '../../lib/content';

export async function getStaticPaths() {
	const [posts, projects] = await Promise.all([getPosts(), getProjects()]);
	const visibleProjects = new Set(projects.map((project) => project.id));
	return posts.map((post, i) => {
		const projectId = post.data.project?.id;
		// A post with `part` pages through its series; any other post pages by date.
		if (post.data.part !== undefined && projectId && visibleProjects.has(projectId)) {
			const series = seriesOf(posts, projectId);
			const at = series.indexOf(post);
			return {
				params: { slug: post.id },
				props: { post, newer: series[at + 1], older: series[at - 1], seriesLength: series.length },
			};
		}
		// posts are newest-first, so "newer" is the previous index
		return {
			params: { slug: post.id },
			props: { post, newer: posts[i - 1], older: posts[i + 1] },
		};
	});
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
	// Set only when the post is part of a visible project's series.
	seriesLength?: number;
}

const { post, newer, older, seriesLength } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, heroImage, project, part, draft } = post.data;
const { Content } = await render(post);
const entry = project ? await getEntry(project) : undefined;
const linkedProject = entry && (!import.meta.env.PROD || !entry.data.draft) ? entry : undefined;
const inSeries = seriesLength !== undefined && linkedProject !== undefined;
const pagerLabel = (other: Post, fallback: string) =>
	inSeries && other.data.part !== undefined ? `${other.data.part}편` : fallback;
---

<BaseLayout title={title} description={description} image={heroImage} type="article">
	<article class="container narrow">
		<header class="head">
			<div class="meta">
				<a class={`cat cat-${category}`} href={url(`/posts/category/${category}/`)}>{CATEGORIES[category].label}</a>
				<FormattedDate date={pubDate} />
				<span>· {readingMinutes(post.body)}분 읽기</span>
				{draft && <span class="draft-badge">DRAFT · 배포되지 않음</span>}
			</div>
			{
				inSeries && (
					<a class="series" href={url(`/portfolio/${linkedProject.id}/`)}>
						{linkedProject.data.title} 연재 <strong>{part}편</strong>
						<span>· 전체 {seriesLength}편</span>
					</a>
				)
			}
			<h1>{title}</h1>
			<p class="desc">{description}</p>
			{
				updatedDate && (
					<p class="updated">
						마지막 수정 <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>

		{heroImage && <Image class="hero" src={heroImage} alt="" width={1440} />}

		{
			linkedProject && (
				<a class="project-link" href={url(`/portfolio/${linkedProject.id}/`)}>
					<span class="label">관련 프로젝트</span>
					<strong>{linkedProject.data.title}</strong>
					<span class="arrow">→</span>
				</a>
			)
		}

		<div class="prose">
			<Content />
		</div>

		{
			tags.length > 0 && (
				<div class="tags">
					{tags.map((tag) => (
						<a class="chip" href={url(`/tags/${tag}/`)}>
							#{tag}
						</a>
					))}
				</div>
			)
		}

		<nav class="pager" aria-label={inSeries ? '이전·다음 편' : '이전·다음 글'}>
			{
				older ? (
					<a href={url(`/posts/${older.id}/`)}>
						<span>← {pagerLabel(older, '이전 글')}</span>
						<strong>{older.data.title}</strong>
					</a>
				) : (
					<span />
				)
			}
			{
				newer && (
					<a class="next" href={url(`/posts/${newer.id}/`)}>
						<span>{pagerLabel(newer, '다음 글')} →</span>
						<strong>{newer.data.title}</strong>
					</a>
				)
			}
		</nav>
	</article>
</BaseLayout>

<style>
	.head {
		padding: 56px 0 32px;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 12px;
		color: var(--muted);
		font-size: 0.88rem;
	}
	.series {
		display: inline-block;
		margin-top: 16px;
		color: var(--text-soft);
		font-size: 0.92rem;
		font-weight: 600;
		text-decoration: none;
	}
	.series strong {
		color: var(--primary);
		font-variant-numeric: tabular-nums;
	}
	.series span {
		margin-left: 4px;
		color: var(--muted);
		font-weight: 400;
	}
	.series:hover {
		color: var(--primary);
	}
	h1 {
		margin: 12px 0 10px;
		font-size: clamp(1.7rem, 4.5vw, 2.3rem);
		line-height: 1.35;
		letter-spacing: -0.03em;
	}
	.desc {
		margin: 0;
		color: var(--muted);
		font-size: 1.05rem;
	}
	.updated {
		margin: 8px 0 0;
		color: var(--muted);
		font-size: 0.85rem;
	}
	.hero {
		display: block;
		width: 100%;
		margin-bottom: 40px;
		border: 1px solid var(--hairline);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}
	.project-link {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 36px;
		padding: 14px 18px;
		border: 1px solid var(--hairline);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: var(--edge);
		-webkit-backdrop-filter: var(--blur);
		backdrop-filter: var(--blur);
		text-decoration: none;
	}
	.project-link .label {
		color: var(--muted);
		font-size: 0.82rem;
	}
	.project-link .arrow {
		margin-left: auto;
		color: var(--muted);
	}
	.project-link:hover {
		box-shadow:
			0 0 0 2px var(--highlight),
			var(--edge);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 48px;
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
		margin-top: 40px;
		padding-top: 24px;
		border-top: 1px solid var(--border);
	}
	.pager a {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 14px 16px;
		border-radius: var(--radius);
		text-decoration: none;
	}
	.pager a:hover {
		background: var(--control-hover);
	}
	.pager span {
		color: var(--muted);
		font-size: 0.82rem;
	}
	.pager strong {
		font-size: 0.95rem;
		line-height: 1.45;
	}
	.pager .next {
		text-align: right;
	}
	@media (max-width: 640px) {
		.head {
			padding: 36px 0 24px;
		}
		.pager {
			grid-template-columns: 1fr;
		}
	}
</style>
