---
import { CATEGORIES } from '../consts';
import { readingMinutes, url, type Post } from '../lib/content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
	showCategory?: boolean;
}

const { posts, showCategory = true } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">아직 글이 없습니다.</p>
	) : (
		<ul class="post-list">
			{posts.map((post) => (
				<li>
					<a class="item" href={url(`/posts/${post.id}/`)}>
						<div class="meta">
							{showCategory && (
								<span class={`cat cat-${post.data.category}`}>{CATEGORIES[post.data.category].label}</span>
							)}
							<FormattedDate date={post.data.pubDate} />
							<span>· {readingMinutes(post.body)}분</span>
							{post.data.draft && <span class="draft-badge">DRAFT</span>}
						</div>
						<h3>{post.data.title}</h3>
						<p>{post.data.description}</p>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	/* One glass panel holding the rows, separated by hairlines. */
	.post-list {
		margin: 0;
		padding: 6px;
		border: 1px solid var(--hairline);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: var(--edge);
		-webkit-backdrop-filter: var(--blur);
		backdrop-filter: var(--blur);
		list-style: none;
	}
	.post-list li + li {
		border-top: 1px solid var(--border);
	}
	.item {
		display: block;
		padding: 16px 18px;
		border-radius: calc(var(--radius) - 6px);
		text-decoration: none;
		transition: background 0.15s;
	}
	.item:hover {
		background: var(--control-hover);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 10px;
		color: var(--muted);
		font-size: 0.85rem;
	}
	h3 {
		margin: 6px 0 4px;
		font-size: 1.2rem;
		line-height: 1.45;
		letter-spacing: -0.015em;
		transition: color 0.15s;
	}
	p {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.item:hover h3 {
		color: var(--primary);
	}
</style>
