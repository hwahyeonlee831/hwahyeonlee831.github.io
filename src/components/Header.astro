---
import { SITE_TITLE } from '../consts';
import { url } from '../lib/content';

const links = [
	{ href: '/posts', label: '글' },
	{ href: '/portfolio', label: '프로젝트' },
	{ href: '/about', label: '소개' },
];
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`) || (href === '/posts' && path.startsWith('/tags'));
---

<header class="site-header">
	<div class="container bar">
		<a class="brand" href={url('/')}>{SITE_TITLE}</a>
		<nav aria-label="주요 메뉴">
			{
				links.map(({ href, label }) => (
					<a href={url(href)} class:list={{ active: isActive(href) }} aria-current={isActive(href) ? 'page' : undefined}>
						{label}
					</a>
				))
			}
			<button class="theme-toggle" type="button" aria-label="다크 모드 전환" title="다크 모드 전환">
				<svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
					<path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
				</svg>
				<svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
				</svg>
			</button>
		</nav>
	</div>
</header>

<script>
	const root = document.documentElement;
	const isDark = () =>
		root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
	document.querySelector('.theme-toggle')?.addEventListener('click', () => {
		const next = isDark() ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid var(--hairline);
		background: var(--surface-strong);
		box-shadow: 0 1px 0 var(--border);
		-webkit-backdrop-filter: var(--blur);
		backdrop-filter: var(--blur);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		height: 68px;
	}
	.brand {
		font-weight: 800;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
		text-decoration: none;
		white-space: nowrap;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	/* 44px capsules. The selected one gets lighter glass, a 2px primary edge and bold text. */
	nav a {
		display: inline-flex;
		align-items: center;
		height: var(--control-h);
		padding: 0 16px;
		border: 1px solid transparent;
		border-radius: calc(var(--control-h) / 2);
		color: var(--muted);
		font-size: 0.94rem;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		transition: background 0.15s;
	}
	nav a:hover {
		background: var(--control-hover);
		color: var(--text);
	}
	nav a.active {
		border: 2px solid var(--primary);
		padding: 0 15px;
		background: var(--selected);
		color: var(--text);
		font-weight: 700;
	}
	.theme-toggle {
		display: grid;
		place-items: center;
		width: var(--control-h);
		height: var(--control-h);
		margin-left: 4px;
		border: 1px solid var(--hairline);
		border-radius: 50%;
		background: var(--control);
		box-shadow: var(--edge);
		color: var(--muted);
		cursor: pointer;
	}
	.theme-toggle:hover {
		background: var(--control-hover);
		color: var(--text);
	}
	.moon {
		display: none;
	}
	:global(:root[data-theme='dark']) .sun {
		display: none;
	}
	:global(:root[data-theme='dark']) .moon {
		display: block;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .sun {
			display: none;
		}
		:global(:root:not([data-theme='light'])) .moon {
			display: block;
		}
	}
	@media (max-width: 420px) {
		nav {
			gap: 0;
		}
		nav a {
			padding: 0 10px;
		}
		nav a.active {
			padding: 0 9px;
		}
	}
</style>
